{
  "name": "document-workspace",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "description": "Monorepo for bybrowser.com — local-first OnlyOffice document editor",
  "scripts": {
    "dev": "pnpm --filter=@bybrowser/web dev",
    "build": "pnpm --filter=@bybrowser/web build",
    "preview": "pnpm --filter=@bybrowser/web preview",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm -r run test:coverage",
    "test:e2e": "pnpm --filter=@bybrowser/web test:e2e",
    "lint": "pnpm -r run lint",
    "lint:ts": "pnpm -r run lint:ts",
    "format:check": "pnpm -r run format:check",
    "format": "prettier --write ."
  },
  "keywords": [
    "onlyoffice",
    "document-editor",
    "privacy",
    "web-based",
    "docx",
    "xlsx",
    "pptx",
    "csv",
    "wasm",
    "webassembly",
    "local-editor",
    "browser-editor",
    "document-converter",
    "office-suite"
  ],
  "author": "ranuts",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ranuts/document.git"
  },
  "homepage": "https://bybrowser.com/",
  "bugs": {
    "url": "https://github.com/ranuts/document/issues"
  },
  "devDependencies": {
    "prettier": "^3.8.3"
  }
}
