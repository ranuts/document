+  // Experimental text-only preflight. Shares generation's parser and tokenizer;
+  // never creates a response reader, posts a task, or evaluates model state.
+  glue_msg_count_chat_res action_count_chat(const char *req_raw)
+  {
+    glue_msg_count_chat_res res;
+    res.success.value = false;
+    res.error.value = "";
+    res.prompt_tokens.value = 0;
+    res.context_tokens.value = 0;
+    try
+    {
+      PARSE_REQ(glue_msg_completion_req);
+      if (!meta || !vocab || !req.is_chat.value || !req.files.arr.empty() || meta->has_mtmd)
+        throw app_exception("count_chat requires a loaded text-only chat model and no files");
+      json body = json::parse(req.data_json.value);
+      if (!body.contains("messages") || !body["messages"].is_array() || body["messages"].empty())
+        throw app_exception("count_chat requires nonempty messages");
+      for (const auto &message : body["messages"])
+      {
+        if (!message.is_object() || !message.contains("content") ||
+            !(message["content"].is_string() || message["content"].is_null()))
+          throw app_exception("count_chat does not support content parts or media");
+      }
+      std::vector<raw_buffer> files;
+      auto parsed = oaicompat_chat_params_parse(body, meta->chat_params, files);
+      if (!files.empty() || !parsed.at("prompt").is_string())
+        throw app_exception("count_chat supports one text prompt only");
+      auto prompts = tokenize_input_prompts(vocab, nullptr, parsed.at("prompt"), true, true, mtmd_helper_init_opt_default());
+      if (prompts.size() != 1 || prompts[0].size() > INT32_MAX || meta->slot_n_ctx <= 0)
+        throw app_exception("count_chat invalid prompt count or context capacity");
+      res.prompt_tokens.value = static_cast<int32_t>(prompts[0].size());
+      res.context_tokens.value = meta->slot_n_ctx;
+      res.success.value = true;
+    }
+    catch (const std::exception &e)
+    {
+      res.error.value = e.what();
+    }
+    return res;
+  }
